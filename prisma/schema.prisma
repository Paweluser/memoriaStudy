generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma" 
}

datasource db {
  provider = "postgresql"
}

model Client {
  id          Int        @id @default(autoincrement())
  firstName   String     @db.VarChar(50)
  lastName    String     @db.VarChar(50)
  phone       String     @db.VarChar(15)
  street      String?    @db.VarChar(100)
  houseNumber String?    @db.VarChar(10)
  zipCode     String?    @db.VarChar(10)
  city        String?    @db.VarChar(100)
  nip         String?    @db.VarChar(10)
  companyName String?    @db.VarChar(255)
  ceremonies  Ceremony[]
}

model Deceased {
  id        Int       @id @default(autoincrement())
  firstName String    @db.VarChar(50)
  lastName  String    @db.VarChar(50)
  pesel     String    @unique @db.Char(11)
  birthDate DateTime  @db.Date
  deathDate DateTime  @db.Date
  insured   Boolean
  ceremony  Ceremony?
}

model Team {
  id         Int        @id @default(autoincrement())
  teamName   String     @db.VarChar(100)
  employees  Employee[]
  ceremonies Ceremony[]
}

model ProductCatalog {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(255)
  category      String         @db.VarChar(50)
  defaultPrice  Decimal        @db.Decimal(10, 2)
  stockQuantity Int?           @default(0)
  estimateItems EstimateItem[]
}

model Employee {
  id                 Int              @id @default(autoincrement())
  teamId             Int?
  firstName          String           @db.VarChar(50)
  lastName           String           @db.VarChar(50)
  email              String           @unique @db.VarChar(255)
  password           String           @db.VarChar(255)
  role               String           @default("EMPLOYEE") @db.VarChar(20)
  
  team               Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sessions           Session[]
  
  // Koniec z "zlecenie_przewozu_zlecenie_przewozu_kierownik_idTopracownik"!
  managedTransports  TransportOrder[] @relation("ManagerToTransport")
  assistedTransports TransportOrder[] @relation("EmployeeToTransport")
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  employee  Employee @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Ceremony {
  id             Int            @id @default(autoincrement())
  clientId       Int?
  deceasedId     Int?           @unique
  teamId         Int?
  city           String         @db.VarChar(100)
  funeralDate    DateTime       @db.Date
  funeralTime    DateTime?      @db.Time(6)
  bringingInTime DateTime?      @db.Time(6)
  gatheringTime  DateTime?      @db.Time(6)
  burialType     String         @db.VarChar(20)
  notes          String?
  
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deceased       Deceased?      @relation(fields: [deceasedId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team           Team?          @relation(fields: [teamId], references: [id], onUpdate: NoAction)
  invoice        Invoice?
  estimateItems  EstimateItem[]
}

model EstimateItem {
  id             Int             @id @default(autoincrement())
  ceremonyId     Int?
  productId      Int?
  purchasedPrice Decimal         @db.Decimal(10, 2)
  quantity       Int             @default(1)
  
  ceremony       Ceremony?       @relation(fields: [ceremonyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product        ProductCatalog? @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model Invoice {
  id            Int       @id @default(autoincrement())
  ceremonyId    Int?      @unique
  invoiceNumber String    @unique @db.VarChar(50)
  issueDate     DateTime  @db.Date
  dueDate       DateTime  @db.Date
  paymentStatus String    @default("PENDING") @db.VarChar(30)
  totalAmount   Decimal   @db.Decimal(10, 2)
  pdfFilePath   String?   @db.VarChar(500)
  
  ceremony      Ceremony? @relation(fields: [ceremonyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model TransportOrder {
  id                Int       @id @default(autoincrement())
  managerId         Int?
  employeeId        Int?
  transportFrom     String    @db.VarChar(255)
  transportTo       String    @db.VarChar(255)
  clientPhoneNumber String    @db.VarChar(15)
  
  manager           Employee? @relation("ManagerToTransport", fields: [managerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assistant         Employee? @relation("EmployeeToTransport", fields: [employeeId], references: [id], onUpdate: NoAction)
}