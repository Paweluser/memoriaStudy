generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ceremonia {
  id                 Int                 @id @default(autoincrement())
  zleceniodawca_id   Int?
  zmarly_id          Int?                @unique
  zespol_id          Int?
  miejscowosc        String              @db.VarChar(100)
  data_pogrzebu      DateTime            @db.Date
  godzina_pogrzebu   DateTime?           @db.Time(6)
  godzina_wniesienia DateTime?           @db.Time(6)
  godzina_zbiorki    DateTime?           @db.Time(6)
  rodzaj_pochowku    String              @db.VarChar(20)
  uwagi              String?
  zespol             zespol?             @relation(fields: [zespol_id], references: [id], onUpdate: NoAction)
  zleceniodawca      zleceniodawca?      @relation(fields: [zleceniodawca_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zmarly             zmarly?             @relation(fields: [zmarly_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  faktura            faktura?
  kosztorys_pozycja  kosztorys_pozycja[]

  @@index([data_pogrzebu], map: "idx_ceremonia_data")
  @@index([miejscowosc], map: "idx_ceremonia_miejscowosc")
}

model faktura {
  id                Int        @id @default(autoincrement())
  ceremonia_id      Int?       @unique
  numer_fv          String     @unique @db.VarChar(50)
  data_wystawienia  DateTime   @db.Date
  termin_platnosci  DateTime   @db.Date
  status_platnosci  String     @default("OCZEKUJĄCA") @db.VarChar(30)
  kwota_calkowita   Decimal    @db.Decimal(10, 2)
  sciezka_pliku_pdf String?    @db.VarChar(500)
  ceremonia         ceremonia? @relation(fields: [ceremonia_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model katalog_produktow {
  id                Int                 @id @default(autoincrement())
  nazwa             String              @db.VarChar(255)
  kategoria         String              @db.VarChar(50)
  cena_domyslna     Decimal             @db.Decimal(10, 2)
  stan_magazynowy   Int?                @default(0)
  kosztorys_pozycja kosztorys_pozycja[]
}

model kosztorys_pozycja {
  id                Int                @id @default(autoincrement())
  ceremonia_id      Int?
  produkt_id        Int?
  cena_zakupiona    Decimal            @db.Decimal(10, 2)
  ilosc             Int                @default(1)
  ceremonia         ceremonia?         @relation(fields: [ceremonia_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  katalog_produktow katalog_produktow? @relation(fields: [produkt_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model pracownik {
  id                                                          Int                 @id @default(autoincrement())
  zespol_id                                                   Int?
  imie                                                        String              @db.VarChar(50)
  nazwisko                                                    String              @db.VarChar(50)
  email                                                       String              @unique @db.VarChar(255)
  haslo                                                       String              @db.VarChar(255)
  rola                                                        String              @default("PRACOWNIK") @db.VarChar(20)
  zespol                                                      zespol?             @relation(fields: [zespol_id], references: [id], onUpdate: NoAction)
  zlecenie_przewozu_zlecenie_przewozu_kierownik_idTopracownik zlecenie_przewozu[] @relation("zlecenie_przewozu_kierownik_idTopracownik")
  zlecenie_przewozu_zlecenie_przewozu_pracownik_idTopracownik zlecenie_przewozu[] @relation("zlecenie_przewozu_pracownik_idTopracownik")
}

model zespol {
  id            Int         @id @default(autoincrement())
  nazwa_zespolu String      @db.VarChar(100)
  ceremonia     ceremonia[]
  pracownik     pracownik[]
}

model zlecenie_przewozu {
  id                                                  Int        @id @default(autoincrement())
  kierownik_id                                        Int?
  pracownik_id                                        Int?
  transport_z                                         String     @db.VarChar(255)
  transport_do                                        String     @db.VarChar(255)
  numer_tel_zleceniodawcy                             String     @db.VarChar(15)
  pracownik_zlecenie_przewozu_kierownik_idTopracownik pracownik? @relation("zlecenie_przewozu_kierownik_idTopracownik", fields: [kierownik_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pracownik_zlecenie_przewozu_pracownik_idTopracownik pracownik? @relation("zlecenie_przewozu_pracownik_idTopracownik", fields: [pracownik_id], references: [id], onUpdate: NoAction)
}

model zleceniodawca {
  id           Int         @id @default(autoincrement())
  imie         String      @db.VarChar(50)
  nazwisko     String      @db.VarChar(50)
  telefon      String      @db.VarChar(15)
  ulica        String?     @db.VarChar(100)
  numer_domu   String?     @db.VarChar(10)
  kod_pocztowy String?     @db.VarChar(10)
  miejscowosc  String?     @db.VarChar(100)
  nip          String?     @db.VarChar(10)
  nazwa_firmy  String?     @db.VarChar(255)
  ceremonia    ceremonia[]
}

model zmarly {
  id             Int        @id @default(autoincrement())
  imie           String     @db.VarChar(50)
  nazwisko       String     @db.VarChar(50)
  pesel          String     @unique @db.Char(11)
  data_urodzenia DateTime   @db.Date
  data_smierci   DateTime   @db.Date
  ubezpieczony   Boolean
  ceremonia      ceremonia?
}
